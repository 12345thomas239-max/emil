@switch (Name?.Trim().ToLowerInvariant())
{
    case "home":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4.5 11.3 12 4.8l7.5 6.5"></path>
            <path d="M6.2 10.8V20h11.6v-9.2"></path>
            <path d="M10 20v-5.2h4V20"></path>
        </svg>
        break;
    case "collections":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="4.5" y="5.2" width="15" height="13.6" rx="1.8"></rect>
            <path d="M8 8.8h8"></path>
            <path d="M8 12h8"></path>
            <path d="M8 15.2h5"></path>
        </svg>
        break;
    case "shop":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 8.3 4.8 10.7l1.2 2 1.4-.9V20h9.2v-8.2l1.4.9 1.2-2-3.2-2.4"></path>
            <path d="M9.2 7.8c.5 1.1 1.5 1.8 2.8 1.8s2.3-.7 2.8-1.8"></path>
        </svg>
        break;
    case "about":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12.2" r="8"></circle>
            <path d="M12 10.5v5"></path>
            <path d="M12 7.8h.01"></path>
        </svg>
        break;
    case "contact":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="4.5" y="6" width="15" height="12" rx="1.5"></rect>
            <path d="M5.5 7.2 12 12.6l6.5-5.4"></path>
        </svg>
        break;
    case "profile":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="8.2" r="3.1"></circle>
            <path d="M6.4 19.1c.8-3.3 3.1-4.9 5.6-4.9s4.8 1.6 5.6 4.9"></path>
            <path d="M10 11.6c.6.4 1.3.6 2 .6s1.4-.2 2-.6"></path>
        </svg>
        break;
    case "cart":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M3.8 5.8h1.8l1.9 9.2h9.2l1.9-7H7"></path>
            <circle cx="10.4" cy="19.2" r="1.05"></circle>
            <circle cx="17.1" cy="19.2" r="1.05"></circle>
        </svg>
        break;
    case "jacket":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7.8 5.5 12 7l4.2-1.5 2.3 3.2-1.6 2V20H7.1V10.7L5.5 8.7z"></path>
            <path d="M12 7v13"></path>
            <path d="M9.1 8.8h1.7"></path>
            <path d="M13.2 8.8h1.7"></path>
        </svg>
        break;
    case "tops":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7.1 8.2 4.9 10.3l1.9 2.3 1-.9V20h8.4v-8.3l1 .9 1.9-2.3-2.2-2.1c-1.1-.9-2.1-1.4-3.4-1.7H10.4c-1.3.3-2.3.8-3.3 1.7z"></path>
            <path d="M10.3 7.5c.3.7 1 1.1 1.7 1.1s1.4-.4 1.7-1.1"></path>
        </svg>
        break;
    case "bottoms":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7.8 4.9h8.4l-.8 5.8.8 9.3h-3.1l-1.3-5.8-1.3 5.8H6.6l.8-9.3z"></path>
            <path d="M12 4.9v14.7"></path>
        </svg>
        break;
    case "headwear":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5.2 13.2c.2-2.7 2.8-5.1 6.8-5.1s6.6 2.4 6.8 5.1l-1.1 1.1H6.3z"></path>
            <path d="M6.5 14.3h11"></path>
            <path d="M9.1 11.4c.7-.8 1.7-1.3 2.9-1.3s2.2.5 2.9 1.3"></path>
        </svg>
        break;
    case "accessories":
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M7.1 9.2h9.8l1 10.4H6.1z"></path>
            <path d="M9.1 9.2c0-1.7 1.1-3 2.9-3s2.9 1.3 2.9 3"></path>
            <path d="M9.6 12.1h4.8"></path>
        </svg>
        break;
    case "all":
    default:
        <svg class="ink-icon @CssClass" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M12 4.8 13.7 9l4.3 1.5-3.7 2.8 1.4 4.5-3.7-2.8-3.7 2.8 1.4-4.5-3.7-2.8L10.3 9z"></path>
        </svg>
        break;
}

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public string CssClass { get; set; } = string.Empty;
}