@page "/reset-password"
@using Microsoft.AspNetCore.WebUtilities
@inject IAccountService AccountService
@inject NavigationManager Navigation

<PageTitle>Reset password - OS Arkiv</PageTitle>

<section class="section">
    <div class="container">
        <div class="section__head">
            <h1 class="section__title">Reset password</h1>
            <span class="eyebrow">Enter a new password</span>
        </div>

        @if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(token))
        {
            <div class="form-note" style="color:var(--color-danger); margin-top:1rem;">
                Invalid or expired password reset link.
            </div>
        }
        else if (passwordChanged)
        {
            <div class="form-note" style="margin-top:1rem;">
                Your password has been reset successfully.
            </div>
            <div class="auth-actions" style="margin-top:1.5rem;">
                <button type="button" class="btn" @onclick="GoToProfile">Sign in</button>
            </div>
        }
        else
        {
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <div class="form-field">
                    <label for="reset-email">Email</label>
                    <input id="reset-email" type="email" value="@email" disabled />
                </div>
                <div class="form-field">
                    <label for="new-password">New password</label>
                    <input id="new-password" type="password" @bind="newPassword" />
                </div>
                <div class="form-field">
                    <label for="confirm-password">Repeat password</label>
                    <input id="confirm-password" type="password" @bind="confirmPassword" />
                </div>

                <div class="auth-actions">
                    <button type="submit" class="btn">Reset password</button>
                </div>

                @if (!string.IsNullOrWhiteSpace(formMessage))
                {
                    <p class="form-note" style="margin-top:0.85rem; color:@(formError ? "var(--color-danger)" : "var(--color-ink)");">
                        @formMessage
                    </p>
                }
            </form>
        }
    </div>
</section>

@code {
    private string email = string.Empty;
    private string token = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool passwordChanged;
    private string? formMessage;
    private bool formError;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);
        if (query.TryGetValue("email", out var emailValue))
        {
            email = emailValue.ToString() ?? string.Empty;
        }

        if (query.TryGetValue("token", out var tokenValue))
        {
            token = tokenValue.ToString() ?? string.Empty;
        }
    }

    private void GoToProfile()
    {
        Navigation.NavigateTo("/profile");
    }

    private Task HandleSubmit()
    {
        formMessage = null;
        formError = false;

        if (string.IsNullOrWhiteSpace(newPassword) || string.IsNullOrWhiteSpace(confirmPassword))
        {
            formMessage = "Enter a new password and repeat it.";
            formError = true;
            return Task.CompletedTask;
        }

        if (newPassword != confirmPassword)
        {
            formMessage = "Passwords do not match.";
            formError = true;
            return Task.CompletedTask;
        }

        if (AccountService.ResetPassword(email, token, newPassword, out var errorMessage))
        {
            passwordChanged = true;
            formMessage = "Password changed successfully. You can now sign in.";
            formError = false;
            newPassword = string.Empty;
            confirmPassword = string.Empty;
            return Task.CompletedTask;
        }

        formMessage = errorMessage;
        formError = true;
        return Task.CompletedTask;
    }
}
