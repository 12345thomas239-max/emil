@page "/profile"
@using Microsoft.AspNetCore.WebUtilities
@inject IAccountService AccountService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Profile - OS Arkiv</PageTitle>

<section class="section">
    <div class="container profile-page">
        <div class="profile-hero">
            <div>
                <div class="eyebrow">My account</div>
                <h1 class="section__title" style="margin-top:0.5rem;">Profile</h1>
            </div>

        </div>

        @if (missingDeliveryAddress)
        {
            <div class="form-note" style="margin-bottom:1rem; color:var(--color-accent);">
                Please add your delivery address, postal code and city in your profile before you can complete checkout.
            </div>
        }

        @if (currentAccount is null)
        {
            <div class="profile-empty-state">
                <span class="profile-empty-state__icon" aria-hidden="true"><InkIcon Name="Profile" /></span>
                <h2 class="profile-empty-state__title">Nothing here to show</h2>
                <p class="prose" style="margin:0;">
                    You are not signed in yet, so your orders and profile details are hidden.
                </p>
            </div>

            <div class="auth-shell">
                <section class="auth-card">
                    <div class="auth-card__head">
                        <div>
                            <h2 class="section__title">@(showRegisterForm ? "Create account" : "Sign in")</h2>
                            <span class="auth-card__note">@(showRegisterForm ? "New customer" : "Existing account")</span>
                        </div>
                        <button type="button" class="auth-switch-link" @onclick="ToggleAuthMode">
                            @(showRegisterForm ? "Already have an account? Sign in" : "No account yet? Create one")
                        </button>
                    </div>

                    @if (!showRegisterForm)
                    {
                        <form @onsubmit="HandleLogin" @onsubmit:preventDefault="true">
                            <div class="form-field">
                                <label for="login-email">Email or username</label>
                                <input id="login-email" @bind="loginModel.Email" />
                            </div>
                            <div class="form-field">
                                <label for="login-password">Password</label>
                                <input id="login-password" type="@(showLoginPassword ? "text" : "password")" @bind="loginModel.Password" />
                                <label class="toggle-password">
                                    <input type="checkbox" @bind="showLoginPassword" />
                                    Show password
                                </label>
                            </div>

                            <div class="auth-actions">
                                <button type="submit" class="btn">Sign in</button>
                            </div>

                            <p class="form-note" style="margin-top:0.85rem;">Admin demo: email <strong>admin</strong> · password <strong>admin</strong></p>

                            @if (!string.IsNullOrWhiteSpace(loginMessage))
                            {
                                <p class="form-note" style="color:var(--color-ink); margin-top:0.85rem;">@loginMessage</p>
                            }
                        </form>
                    }
                    else
                    {
                        <EditForm Model="registerModel" OnValidSubmit="HandleRegister">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="form-grid">
                                <div class="form-field">
                                    <label for="register-first-name">First name</label>
                                    <input id="register-first-name" @bind="registerModel.FirstName" />
                                </div>
                                <div class="form-field">
                                    <label for="register-last-name">Last name</label>
                                    <input id="register-last-name" @bind="registerModel.LastName" />
                                </div>
                            </div>

                            <div class="form-field">
                                <label for="register-phone">Phone number</label>
                                <div class="phone-field">
                                    <select id="register-phone-country" class="phone-field__select" @bind="registerPhoneCountryCode">
                                        <option value="+45">🇩🇰 DK +45</option>
                                        <option value="+43">🇦🇹 AT +43</option>
                                        <option value="+32">🇧🇪 BE +32</option>
                                        <option value="+359">🇧🇬 BG +359</option>
                                        <option value="+385">🇭🇷 HR +385</option>
                                        <option value="+357">🇨🇾 CY +357</option>
                                        <option value="+420">🇨🇿 CZ +420</option>
                                        <option value="+45">🇩🇰 DK +45</option>
                                        <option value="+372">🇪🇪 EE +372</option>
                                        <option value="+358">🇫🇮 FI +358</option>
                                        <option value="+33">🇫🇷 FR +33</option>
                                        <option value="+49">🇩🇪 DE +49</option>
                                        <option value="+30">🇬🇷 GR +30</option>
                                        <option value="+353">🇮🇪 IE +353</option>
                                        <option value="+39">🇮🇹 IT +39</option>
                                        <option value="+371">🇱🇻 LV +371</option>
                                        <option value="+370">🇱🇹 LT +370</option>
                                        <option value="+352">🇱🇺 LU +352</option>
                                        <option value="+356">🇲🇹 MT +356</option>
                                        <option value="+31">🇳🇱 NL +31</option>
                                        <option value="+47">🇳🇴 NO +47</option>
                                        <option value="+48">🇵🇱 PL +48</option>
                                        <option value="+351">🇵🇹 PT +351</option>
                                        <option value="+40">🇷🇴 RO +40</option>
                                        <option value="+421">🇸🇰 SK +421</option>
                                        <option value="+386">🇸🇮 SI +386</option>
                                        <option value="+34">🇪🇸 ES +34</option>
                                        <option value="+46">🇸🇪 SE +46</option>
                                        <option value="+41">🇨🇭 CH +41</option>
                                        <option value="+44">🇬🇧 UK +44</option>
                                        <option value="+1">🇺🇸 US +1</option>
                                    </select>
                                    <input id="register-phone" type="tel" class="phone-field__input" @bind="registerModel.Phone" />
                                </div>
                            </div>
                            <div class="form-field">
                                <label for="register-email">Email</label>
                                <input id="register-email" type="email" @bind="registerModel.Email" />
                            </div>
                            <div class="form-field form-field--full">
                                <label for="register-address">Delivery address</label>
                                <input id="register-address" @bind="registerModel.Address" />
                            </div>
                            <div class="form-field">
                                <label for="register-postal">Postal code</label>
                                <input id="register-postal" @bind="registerModel.PostalCode" />
                            </div>
                            <div class="form-field">
                                <label for="register-city">City</label>
                                <input id="register-city" @bind="registerModel.City" />
                            </div>
                            <div class="form-field">
                                <label for="register-password">Password</label>
                                <input id="register-password" type="@(showRegisterPassword ? "text" : "password")" @bind="registerModel.Password" />
                                <label class="toggle-password">
                                    <input type="checkbox" @bind="showRegisterPassword" />
                                    <span class="toggle-password__track" aria-hidden="true"></span>
                                    <span>Show password</span>
                                </label>
                            </div>
                            <div class="form-field">
                                <label for="register-password-confirm">Repeat password</label>
                                <input id="register-password-confirm" type="@(showRegisterPassword ? "text" : "password")" @bind="registerModel.ConfirmPassword" />
                            </div>

                            <button type="submit" class="btn btn--block">Create account</button>

                            @if (!string.IsNullOrWhiteSpace(registerMessage))
                            {
                                <p class="form-note" style="color:var(--color-ink); margin-top:0.85rem;">@registerMessage</p>
                            }
                        </EditForm>
                    }
                </section>
            </div>
        }
        else
        {
            <div class="profile-layout">
                <section class="profile-panel profile-panel--orders">
                    <div class="section__head">
                        <h2 class="section__title">Orders</h2>
                        <span class="eyebrow">Receipts and status</span>
                    </div>

                    <div class="profile-orders">
                        @if (currentAccount.Orders.Count == 0)
                        {
                            <p class="empty-state">No orders yet. Once you check out, the receipts will show up here.</p>
                        }
                        else
                        {
                            @foreach (var order in currentAccount.Orders)
                            {
                                <article class="profile-order @(SelectedOrder?.Id == order.Id ? "active" : "")">
                                    <button type="button" class="profile-order__header" @onclick="() => SelectOrder(order)">
                                        <div>
                                            <div class="profile-order__number">@order.Number</div>
                                            <div class="profile-order__meta">@order.OrderedAt.ToString("dd MMM yyyy") · @order.ItemCount items</div>
                                        </div>
                                        <div class="profile-order__status">@order.Status</div>
                                    </button>

                                    <div class="profile-order__body">
                                        <div class="profile-order__row">
                                            <span>Receipt</span>
                                            <span>@order.Number</span>
                                        </div>
                                        <div class="profile-order__row">
                                            <span>Items</span>
                                            <span>@order.ItemCount</span>
                                        </div>
                                        <div class="profile-order__row">
                                            <span>Total</span>
                                            <span>@order.Total.ToString("0") kr.</span>
                                        </div>
                                    </div>
                                </article>
                            }
                        }
                    </div>

                    @if (SelectedOrder is not null)
                    {
                        <div class="profile-receipt">
                            <div class="profile-receipt__head">
                                <div>
                                    <div class="eyebrow">Selected receipt</div>
                                    <h3>@SelectedOrder.Number</h3>
                                </div>
                                <div class="profile-order__status">@SelectedOrder.Status</div>
                            </div>

                            <div class="profile-receipt__details">
                                <div><span>Placed</span><strong>@SelectedOrder.OrderedAt.ToString("dd MMM yyyy")</strong></div>
                                <div><span>Shipping</span><strong>@SelectedOrder.Fulfillment</strong></div>
                                <div><span>Receipt</span><strong>@SelectedOrder.Number</strong></div>
                                <div><span>Total</span><strong>@SelectedOrder.Total.ToString("0") kr.</strong></div>
                            </div>

                            <div class="profile-receipt__items">
                                @foreach (var line in SelectedOrder.ReceiptLines)
                                {
                                    <div class="profile-receipt__line @(line.Label == "Total" ? "profile-receipt__line--total" : string.Empty)">
                                        <span>@line.Label</span>
                                        <span>@($"{line.Amount:0} kr.")</span>
                                    </div>
                                }
                            </div>

                            <div class="profile-receipt__items">
                                @foreach (var item in SelectedOrder.Items)
                                {
                                    <div class="profile-receipt__item">
                                        <span>@item.Name</span>
                                        <span>@item.Quantity x @item.UnitPrice.ToString("0") kr.</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </section>

                <section class="profile-panel profile-panel--details">
                    <div class="section__head">
                        <h2 class="section__title">Contact details</h2>
                        <span class="eyebrow">Editable profile</span>
                    </div>

                    <EditForm Model="profileModel" OnValidSubmit="SaveProfile">
                        <DataAnnotationsValidator />
                        <ValidationSummary />

                        <div class="form-grid">
                            <div class="form-field">
                                <label for="profile-first-name">First name</label>
                                <input id="profile-first-name" @bind="profileModel.FirstName" />
                            </div>
                            <div class="form-field">
                                <label for="profile-last-name">Last name</label>
                                <input id="profile-last-name" @bind="profileModel.LastName" />
                            </div>
                        </div>

                        <div class="form-field">
                            <label for="profile-phone">Phone number</label>
                            <div class="phone-field">
                                <select id="profile-phone-country" class="phone-field__select" @bind="profilePhoneCountryCode">
                                    <option value="+45">🇩🇰 DK +45</option>
                                    <option value="+43">🇦🇹 AT +43</option>
                                    <option value="+32">🇧🇪 BE +32</option>
                                    <option value="+359">🇧🇬 BG +359</option>
                                    <option value="+385">🇭🇷 HR +385</option>
                                    <option value="+357">🇨🇾 CY +357</option>
                                    <option value="+420">🇨🇿 CZ +420</option>
                                    <option value="+45">🇩🇰 DK +45</option>
                                    <option value="+372">🇪🇪 EE +372</option>
                                    <option value="+358">🇫🇮 FI +358</option>
                                    <option value="+33">🇫🇷 FR +33</option>
                                    <option value="+49">🇩🇪 DE +49</option>
                                    <option value="+30">🇬🇷 GR +30</option>
                                    <option value="+353">🇮🇪 IE +353</option>
                                    <option value="+39">🇮🇹 IT +39</option>
                                    <option value="+371">🇱🇻 LV +371</option>
                                    <option value="+370">🇱🇹 LT +370</option>
                                    <option value="+352">🇱🇺 LU +352</option>
                                    <option value="+356">🇲🇹 MT +356</option>
                                    <option value="+31">🇳🇱 NL +31</option>
                                    <option value="+47">🇳🇴 NO +47</option>
                                    <option value="+48">🇵🇱 PL +48</option>
                                    <option value="+351">🇵🇹 PT +351</option>
                                    <option value="+40">🇷🇴 RO +40</option>
                                    <option value="+421">🇸🇰 SK +421</option>
                                    <option value="+386">🇸🇮 SI +386</option>
                                    <option value="+34">🇪🇸 ES +34</option>
                                    <option value="+46">🇸🇪 SE +46</option>
                                    <option value="+41">🇨🇭 CH +41</option>
                                    <option value="+44">🇬🇧 UK +44</option>
                                    <option value="+1">🇺🇸 US +1</option>
                                </select>
                                <input id="profile-phone" type="tel" class="phone-field__input" @bind="profileModel.Phone" />
                            </div>
                        </div>
                        <div class="form-field">
                            <label for="profile-email">Email</label>
                            <input id="profile-email" type="email" @bind="profileModel.Email" />
                        </div>
                        <div class="form-field form-field--full">
                            <label for="profile-address">Delivery address</label>
                            <input id="profile-address" @bind="profileModel.Address" @bind:event="oninput" />
                        </div>
                        <div class="form-field">
                            <label for="profile-postal">Postal code</label>
                            <input id="profile-postal" @bind="profileModel.PostalCode" />
                        </div>
                        <div class="form-field">
                            <label for="profile-city">City</label>
                            <input id="profile-city" @bind="profileModel.City" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(profileModel.Address))
                        {
                            <p class="form-note" style="margin-top:0.5rem; color:var(--color-muted);">
                                Indtast din leveringsadresse her. Den gemmes uden Google-autocomplete.
                            </p>
                        }
                        <div class="form-field">
                            <label for="profile-new-password">New password</label>
                            <input id="profile-new-password" type="@(showProfilePassword ? "text" : "password")" @bind="profileModel.NewPassword" />
                            <label class="toggle-password">
                                <input type="checkbox" @bind="showProfilePassword" />
                                <span class="toggle-password__track" aria-hidden="true"></span>
                                <span>Show password</span>
                            </label>
                        </div>
                        <div class="form-field">
                            <label for="profile-confirm-password">Repeat new password</label>
                            <input id="profile-confirm-password" type="@(showProfilePassword ? "text" : "password")" @bind="profileModel.ConfirmPassword" />
                        </div>

                        <div class="profile-session-actions">
                            <button type="submit" class="btn">Save profile</button>
                            <button type="button" class="btn btn--ghost" @onclick="Logout">Log out</button>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(profileMessage))
                        {
                            <p class="form-note" style="color:var(--color-ink); margin-top:0.85rem;">@profileMessage</p>
                        }
                    </EditForm>
                </section>
            </div>
        }
    </div>
</section>

@code {
    private AccountView? currentAccount;
    private string? loginMessage;
    private string? registerMessage;
    private string? profileMessage;
    private string? returnUrl;
    private bool missingDeliveryAddress;
    private bool showLoginPassword;
    private bool showRegisterPassword;
    private bool showProfilePassword;
    private bool showRegisterForm;
    private string registerPhoneCountryCode = "+45";
    private string profilePhoneCountryCode = "+45";
    private string? selectedOrderId;

    private readonly LoginModel loginModel = new()
    {
        Email = "admin",
        Password = "admin"
    };

    private RegisterModel registerModel = new();
    private ProfileModel profileModel = new();

    private OrderView? SelectedOrder => currentAccount?.Orders.FirstOrDefault(order => order.Id == selectedOrderId) ?? currentAccount?.Orders.FirstOrDefault();

    protected override Task OnInitializedAsync()
    {
        // Capture optional returnUrl query parameter so we can redirect after login/register
        try
        {
            var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
            var q = QueryHelpers.ParseQuery(uri.Query);
            if (q.TryGetValue("returnUrl", out var rv))
            {
                returnUrl = rv;
            }

            if (q.TryGetValue("missingDelivery", out var missingDeliveryValue) &&
                bool.TryParse(missingDeliveryValue, out var missingDelivery))
            {
                missingDeliveryAddress = missingDelivery;
            }
        }
        catch
        {
            // ignore parse issues
        }

        SyncFromAccountService();
        return Task.CompletedTask;
    }


    private void ToggleAuthMode()
    {
        showRegisterForm = !showRegisterForm;
    }

    private async Task HandleLogin()
    {
        if (AccountService.Login(loginModel.Email, loginModel.Password, out var errorMessage))
        {
            loginMessage = null;
            registerMessage = null;
            profileMessage = null;
            SyncFromAccountService();
            await SaveAccountSessionAsync();
            if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                Navigation.NavigateTo(returnUrl);
                return;
            }

            return;
        }

        loginMessage = errorMessage;
        StateHasChanged();
    }

    private async Task HandleRegister()
    {
        var fullPhone = BuildPhoneNumber(registerPhoneCountryCode, registerModel.Phone);

        if (AccountService.Register(registerModel.FirstName, registerModel.LastName, fullPhone, registerModel.Email, registerModel.Password, registerModel.Address, registerModel.PostalCode, registerModel.City, out var errorMessage))
        {
            registerMessage = "Account created. You are now signed in.";
            loginMessage = null;
            profileMessage = null;
            SyncFromAccountService();
            await SaveAccountSessionAsync();
            if (!string.IsNullOrWhiteSpace(returnUrl))
            {
                Navigation.NavigateTo(returnUrl);
                return;
            }

            return;
        }

        registerMessage = errorMessage;
    }

    private async Task SaveProfile()
    {
        var fullPhone = BuildPhoneNumber(profilePhoneCountryCode, profileModel.Phone);

        if (AccountService.UpdateProfile(
            profileModel.FirstName,
            profileModel.LastName,
            fullPhone,
            profileModel.Email,
            out var errorMessage,
            profileModel.Address,
            profileModel.PostalCode,
            profileModel.City,
            profileModel.NewPassword))
        {
            profileMessage = "Profile saved.";
            SyncFromAccountService();
            await SaveAccountSessionAsync();
            return;
        }

        profileMessage = errorMessage;
    }

    private async Task Logout()
    {
        AccountService.Logout();
        loginMessage = null;
        registerMessage = null;
        profileMessage = null;
        selectedOrderId = null;
        SyncFromAccountService();
        await RemoveAccountSessionAsync();
    }

    private void SelectOrder(OrderView order)
    {
        selectedOrderId = order.Id;
    }

    

    private void FillDemoLogin()
    {
        loginModel.Email = "demo@osarkiv.dk";
        loginModel.Password = "DemoPass8";
        showLoginPassword = true;
    }

    private async Task SaveAccountSessionAsync()
    {
        if (AccountService.CurrentAccount is not null)
        {
            await JS.InvokeVoidAsync("sessionStorage.setItem", "osarkiv-account-email", AccountService.CurrentAccount.Email);
        }
    }

    private async Task RemoveAccountSessionAsync()
    {
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "osarkiv-account-email");
    }

    private void SyncFromAccountService()
    {
        currentAccount = AccountService.CurrentAccount;

        if (currentAccount is null)
        {
            selectedOrderId = null;
            profileModel = new ProfileModel();
            return;
        }

        profilePhoneCountryCode = ExtractCountryCode(currentAccount.Phone);
        profileModel = new ProfileModel
        {
            FirstName = currentAccount.FirstName,
            LastName = currentAccount.LastName,
            Phone = ExtractPhoneNumber(currentAccount.Phone),
            Email = currentAccount.Email,
            Address = currentAccount.Address,
            PostalCode = currentAccount.PostalCode,
            City = currentAccount.City,
            NewPassword = string.Empty,
            ConfirmPassword = string.Empty
        };

        selectedOrderId ??= currentAccount.Orders.FirstOrDefault()?.Id;
        if (!string.IsNullOrWhiteSpace(selectedOrderId) && currentAccount.Orders.All(order => order.Id != selectedOrderId))
        {
            selectedOrderId = currentAccount.Orders.FirstOrDefault()?.Id;
        }
    }

    private static string BuildPhoneNumber(string countryCode, string phoneNumber)
        => string.IsNullOrWhiteSpace(phoneNumber) ? string.Empty : $"{countryCode} {phoneNumber}".Trim();

    private static string ExtractCountryCode(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            return "+45";
        }

        var parts = phone.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length > 0 && parts[0].StartsWith('+') ? parts[0] : "+45";
    }

    private static string ExtractPhoneNumber(string phone)
    {
        if (string.IsNullOrWhiteSpace(phone))
        {
            return string.Empty;
        }

        var parts = phone.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 1 && parts[0].StartsWith('+'))
        {
            return string.Join(" ", parts[1..]);
        }

        return phone;
    }

    private sealed class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Password { get; set; } = string.Empty;
    }

    private sealed class RegisterModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Phone { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Address { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string PostalCode { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string City { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.MinLength(8)]
        public string Password { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class ProfileModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string FirstName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string LastName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Phone { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        [System.ComponentModel.DataAnnotations.EmailAddress]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string Address { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string PostalCode { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required]
        public string City { get; set; } = string.Empty;

        

        public string NewPassword { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Compare(nameof(NewPassword), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}