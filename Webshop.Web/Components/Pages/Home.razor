@page "/"
@inject IProductService ProductService

<PageTitle>OS Arkiv</PageTitle>

<section class="zhero zhero--intro" aria-label="Forsidebillede">
    <div class="zhero__backdrop" aria-hidden="true"></div>
    <div class="zhero__content">
        <a href="shop" class="zhero__cta">Shop Now</a>
    </div>
</section>

@code {
    private Collection? latestCollection;

    protected override async Task OnInitializedAsync()
    {
        latestCollection = await ProductService.GetLatestCollectionAsync();
    }
}
