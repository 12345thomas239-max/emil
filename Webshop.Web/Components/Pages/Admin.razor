    private void SetStatusMessage(string message, string type = "info")
    {
        statusMessage = message;
        statusMessageType = type;
        showStatusMessage = true;

        statusTimer?.Dispose();
        statusTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                showStatusMessage = false;
                statusMessage = string.Empty;
                statusMessageType = "info";
                StateHasChanged();
            });
        }, null, 4000, System.Threading.Timeout.Infinite);
    }

    private void CloseStatusMessage()
    {
        statusTimer?.Dispose();
        statusTimer = null;
        showStatusMessage = false;
        statusMessage = string.Empty;
        statusMessageType = "info";
    }

    private void ClearStatusMessage()
    {
        statusTimer?.Dispose();
        statusTimer = null;
        showStatusMessage = false;
        statusMessage = string.Empty;
        statusMessageType = "info";
    }

    private string GetStatusMessageClass()
    {
        return statusMessageType switch
        {
            "success" => "admin-toast--success",
            "error" => "admin-toast--error",
            _ => "admin-toast--info"
        };
    }

    private string GetStatusIcon()
    {
        return statusMessageType switch
        {
            "success" => "✓",
            "error" => "!",
            _ => "i"
        };
    }

    public void Dispose()
    {
        statusTimer?.Dispose();
    }

    private bool IsProductInActiveCollection(Product product)
    {
        var activeCollectionNumber = collectionModel.Number > 0 ? collectionModel.Number : productModel.CollectionNumber;
        return activeCollectionNumber > 0 && product.CollectionNumber == activeCollectionNumber;
    }

    private string GetCollectionLabel(int collectionNumber)
    {
        if (collectionNumber <= 0)
        {
            return "Unassigned";
        }

        var collection = collections.FirstOrDefault(c => c.Number == collectionNumber);
        return collection is not null ? $"{collection.Name} ({collection.Number})" : $"Collection {collectionNumber}";
    }

    private string GetProductDeleteLabel(Product product)
    {
        return $"{product.Name} ({product.ArchiveNumber})";
    }

    private string GetCollectionDeleteLabel(Collection collection)
    {
        return $"{collection.Name} ({collection.Number})";
    }

