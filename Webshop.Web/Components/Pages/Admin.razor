    private async Task ConfirmDelete()
    {
        if (pendingDeleteTargetType == "product")
        {
            await HandleDeleteProduct(pendingDeleteProductId);
        }
        else if (pendingDeleteTargetType == "collection")
        {
            await HandleDeleteCollection(pendingDeleteCollectionNumber);
        }

        CancelDeleteConfirmation();
    }

    private async Task HandleDeleteProduct(string id)
    {
        using var client = new HttpClient();
        var response = await client.DeleteAsync(Navigation.ToAbsoluteUri($"/api/admin/products/{id}"));
        if (response.IsSuccessStatusCode)
        {
            SetStatusMessage("Product deleted successfully.", "success");
            await LoadProductsAsync();
            if (productModel.Id == id)
            {
                ResetProductForm();
            }
        }
        else
        {
            SetStatusMessage("Product could not be deleted.", "error");
        }
