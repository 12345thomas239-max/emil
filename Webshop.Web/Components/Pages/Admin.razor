    private async Task HandleCreateCollection()
    {
        var collection = new Collection
        {
            Number = collectionModel.Number,
            Name = collectionModel.Name,
            Season = collectionModel.Season,
            Tagline = collectionModel.Tagline,
            CoverImage = collectionModel.CoverImage
        };

        using var client = new HttpClient();
        HttpResponseMessage response;
        var existingCollection = collections.FirstOrDefault(c => c.Number == collection.Number);
        if (existingCollection is null)
        {
            response = await client.PostAsJsonAsync(Navigation.ToAbsoluteUri("/api/admin/collections"), collection);
        }
        else
        {
            response = await client.PutAsJsonAsync(Navigation.ToAbsoluteUri($"/api/admin/collections/{collection.Number}"), collection);
        }

        if (response.IsSuccessStatusCode)
        {
            SetStatusMessage(collection.Number <= 0 ? "Collection created successfully." : "Collection updated successfully.", "success");
            await LoadCollectionsAsync();
            ResetCollectionForm();
        }
        else
        {
            SetStatusMessage("Collection could not be saved.", "error");
        }

        collectionUploadStatus = string.Empty;
    }

