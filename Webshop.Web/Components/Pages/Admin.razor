    private async Task HandleCollectionImageSelection(InputFileChangeEventArgs args)
    {
        var file = args.File;
        if (file is null)
        {
            collectionUploadStatus = "No file selected yet.";
            return;
        }

        collectionUploadStatus = "Uploading cover image...";

        try
        {
            var uploadedUrl = await UploadFileAsync(file);
            if (string.IsNullOrWhiteSpace(uploadedUrl))
            {
                collectionUploadStatus = "The cover image could not be uploaded.";
                return;
            }

            collectionModel.CoverImage = uploadedUrl;
            collectionUploadStatus = "Cover image URL generated and inserted into the form.";
        }
        catch (Exception ex)
        {
            collectionUploadStatus = $"Upload failed: {ex.Message}";
        }
    }

    private async Task<string?> UploadFileAsync(IBrowserFile file)
    {
        var uploadsFolder = Path.Combine(Env.WebRootPath, "uploads");
        Directory.CreateDirectory(uploadsFolder);

        var safeName = Path.GetFileNameWithoutExtension(file.Name)?.Replace(" ", "-") ?? "upload";
        var extension = Path.GetExtension(file.Name);
        var storedFileName = $"{safeName}-{Guid.NewGuid():N}{extension}";
        var fullPath = Path.Combine(uploadsFolder, storedFileName);

        await using var stream = file.OpenReadStream(20 * 1024 * 1024);
        await using var targetStream = File.Create(fullPath);
        await stream.CopyToAsync(targetStream);

        var baseUrl = new Uri(Navigation.BaseUri).GetLeftPart(UriPartial.Authority);
        return $"{baseUrl}/uploads/{storedFileName}";
    }

    private async Task HandleAssignProductToCollection()
    {
        if (collectionModel.Number <= 0 || string.IsNullOrWhiteSpace(selectedProductToAssignId))
        {
            SetStatusMessage("Choose a collection and a product to assign.", "info");
            return;
        }

        var product = products.FirstOrDefault(p => p.Id == selectedProductToAssignId);
        if (product is null)
        {
            SetStatusMessage("Selected product could not be found.", "error");
            return;
        }

        product.CollectionNumber = collectionModel.Number;
        using var client = new HttpClient();
        var response = await client.PutAsJsonAsync(Navigation.ToAbsoluteUri($"/api/admin/products/{product.Id}"), product);
        if (response.IsSuccessStatusCode)
        {
            SetStatusMessage($"Product '{product.Name}' assigned to collection {collectionModel.Number}.", "success");
            selectedProductToAssignId = string.Empty;
            await LoadProductsAsync();
        }
        else
        {
            SetStatusMessage("Could not assign the product to the collection.", "error");
        }
    }

    private async Task HandleRemoveProductFromCollection(string productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        if (product is null)
        {
            SetStatusMessage("Product could not be found.", "error");
            return;
        }

        product.CollectionNumber = 0;
        using var client = new HttpClient();
        var response = await client.PutAsJsonAsync(Navigation.ToAbsoluteUri($"/api/admin/products/{product.Id}"), product);
        if (response.IsSuccessStatusCode)
        {
            SetStatusMessage($"Product '{product.Name}' removed from the collection.", "success");
            await LoadProductsAsync();
        }
        else
        {
            SetStatusMessage("Could not remove the product from the collection.", "error");
        }
    }

